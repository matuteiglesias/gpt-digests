{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kb-contracts:schema:module:v1",
  "title": "KB knowledge-system module descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "module_id",
    "name",
    "repository",
    "knowledge_profile",
    "accepts",
    "emits",
    "validation",
    "contract_release"
  ],
  "properties": {
    "schema_id": {
      "const": "kb.module"
    },
    "schema_version": {
      "const": "1.0"
    },
    "module_id": {
      "$ref": "#/$defs/registryId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$",
          "maxLength": 257
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$",
          "maxLength": 512
        }
      }
    },
    "knowledge_profile": {
      "$ref": "#/$defs/profile"
    },
    "accepts": {
      "$ref": "#/$defs/interfaceSet"
    },
    "emits": {
      "$ref": "#/$defs/interfaceSet"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?:npm run contract:validate|make [a-zA-Z0-9_.:-]+)$"
        }
      }
    },
    "contract_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "manifest_ref"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "manifest_ref": {
          "$ref": "#/$defs/repositoryRelativeRef"
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_-]*)+$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "registryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level"
      ],
      "properties": {
        "id": {
          "const": "knowledge-interop"
        },
        "level": {
          "const": 1
        }
      }
    },
    "interfaceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_families",
        "schema_versions"
      ],
      "properties": {
        "artifact_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        },
        "schema_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_id",
              "versions"
            ],
            "properties": {
              "schema_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "versions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                }
              }
            }
          }
        }
      }
    },
    "repositoryRelativeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\|https?://)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        }
      ]
    }
  }
}
